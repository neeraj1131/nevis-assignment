# Port the Fastify server listens on.
PORT=3000

# Host/interface the server binds to. Use 0.0.0.0 to accept connections
# from outside the container (Docker), 127.0.0.1 to restrict to localhost.
HOST=0.0.0.0

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# development | test | production. Controls pino-pretty transport (disabled
# in production) and other environment-sensitive defaults.
NODE_ENV=development

# Comma-separated list of allowed CORS origins for the web app.
CORS_ORIGIN=http://localhost:5173
