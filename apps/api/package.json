{
  "name": "@nevis/api",
  "version": "0.1.0",
  "description": "Fastify + zod REST API serving the clients dataset with OpenAPI docs, rate limiting, and ETag caching.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/server.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@nevis/shared": "workspace:*",
    "close-with-grace": "^2.2.0",
    "fastify": "^5.5.0",
    "fastify-type-provider-zod": "^7.0.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
